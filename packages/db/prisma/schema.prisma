generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  OWNER
  MANAGER
  CASHIER
  VIEWER
}

enum DocumentStatus {
  DRAFT
  POSTED
  VOIDED
}

enum PaymentStatus {
  PAID
  PARTIAL
  UNPAID
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  OTHER
}

enum StockMovementType {
  OPENING
  PURCHASE
  PURCHASE_RETURN
  SALE
  SALE_RETURN
  EXCHANGE_IN
  EXCHANGE_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  DAMAGE
  LOST
  FOUND
  TRANSFER_IN
  TRANSFER_OUT
}

enum ReferenceType {
  OPENING
  PURCHASE
  PURCHASE_RETURN
  SALE
  SALE_VOID
  EXCHANGE
  ADJUSTMENT
  TRANSFER
}

enum ExchangeDirection {
  RETURN
  REPLACE
}

enum DocumentType {
  SALE_INVOICE
  PURCHASE
}

// ─── Core tenancy ────────────────────────────────────────────────────────────

model Organization {
  id                       String    @id @default(uuid()) @db.Uuid
  name                     String
  gstin                    String?
  stateCode                String    @map("state_code") @db.Char(2)
  addressLine1             String?   @map("address_line1")
  addressLine2             String?   @map("address_line2")
  city                     String?
  pincode                  String?
  phone                    String?
  email                    String?
  financialYearStartMonth  Int       @default(4) @map("financial_year_start_month")
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy                String?   @map("created_by") @db.Uuid
  updatedBy                String?   @map("updated_by") @db.Uuid

  branches           Branch[]
  locations          Location[]
  users              User[]
  brands             Brand[]
  categories         Category[]
  vendors            Vendor[]
  customers          Customer[]
  articles           Article[]
  articleVariants    ArticleVariant[]
  taxRates           TaxRate[]
  inventoryBalances  InventoryBalance[]
  stockLedger        StockLedger[]
  purchases          Purchase[]
  sales              Sale[]
  exchanges          Exchange[]
  expenseCategories  ExpenseCategory[]
  expenses           Expense[]
  documentSequences  DocumentSequence[]
  auditLogs          AuditLog[]

  @@map("organizations")
}

model Branch {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  code           String
  name           String
  stateCode      String?   @map("state_code") @db.Char(2)
  isDefault      Boolean   @default(false) @map("is_default")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid

  organization      Organization       @relation(fields: [organizationId], references: [id])
  locations         Location[]
  users             User[]
  purchases         Purchase[]
  sales             Sale[]
  exchanges         Exchange[]
  expenses          Expense[]
  documentSequences DocumentSequence[]

  @@index([organizationId])
  @@map("branches")
}

model Location {
  id             String    @id @default(uuid()) @db.Uuid
  branchId       String    @map("branch_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  code           String
  name           String
  isDefault      Boolean   @default(false) @map("is_default")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid

  organization      Organization       @relation(fields: [organizationId], references: [id])
  branch            Branch             @relation(fields: [branchId], references: [id])
  inventoryBalances InventoryBalance[]
  stockLedger       StockLedger[]
  purchases         Purchase[]
  sales             Sale[]
  exchanges         Exchange[]

  @@index([branchId])
  @@index([organizationId])
  @@map("locations")
}

model User {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  email          String
  name           String
  passwordHash   String    @map("password_hash")
  role           UserRole
  branchId       String?   @map("branch_id") @db.Uuid
  isActive       Boolean   @default(true) @map("is_active")
  lastLoginAt    DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Branch?      @relation(fields: [branchId], references: [id])

  @@index([organizationId, email])
  @@index([organizationId, role])
  @@map("users")
}

// ─── Masters ─────────────────────────────────────────────────────────────────

model Brand {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  code           String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id])
  articles     Article[]

  @@index([organizationId])
  @@map("brands")
}

model Category {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  parentId       String?   @map("parent_id") @db.Uuid
  name           String
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id])
  parent       Category?    @relation("CategoryTree", fields: [parentId], references: [id])
  children     Category[]   @relation("CategoryTree")
  articles     Article[]

  @@index([organizationId])
  @@index([parentId])
  @@map("categories")
}

model Vendor {
  id                String    @id @default(uuid()) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  name              String
  gstin             String?
  phone             String?
  email             String?
  address           String?
  stateCode         String?   @map("state_code") @db.Char(2)
  paymentTermsDays  Int?      @map("payment_terms_days")
  notes             String?
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy         String?   @map("created_by") @db.Uuid
  updatedBy         String?   @map("updated_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id])
  purchases    Purchase[]

  @@index([organizationId])
  @@map("vendors")
}

model Customer {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  phone          String?
  email          String?
  gstin          String?
  stateCode      String?   @map("state_code") @db.Char(2)
  address        String?
  isWalkIn       Boolean   @default(false) @map("is_walk_in")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id])
  sales        Sale[]
  exchanges    Exchange[]

  @@index([organizationId])
  @@index([organizationId, phone])
  @@map("customers")
}

model TaxRate {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  totalRate      Decimal   @map("total_rate") @db.Decimal(5, 2)
  cgstRate       Decimal   @map("cgst_rate") @db.Decimal(5, 2)
  sgstRate       Decimal   @map("sgst_rate") @db.Decimal(5, 2)
  igstRate       Decimal   @map("igst_rate") @db.Decimal(5, 2)
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid

  organization  Organization   @relation(fields: [organizationId], references: [id])
  articles      Article[]
  purchaseLines PurchaseLine[]
  saleLines     SaleLine[]
  exchangeLines ExchangeLine[]

  @@index([organizationId])
  @@map("tax_rates")
}

model Article {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  brandId          String    @map("brand_id") @db.Uuid
  categoryId       String    @map("category_id") @db.Uuid
  name             String
  articleCode      String    @map("article_code")
  hsnCode          String?   @map("hsn_code")
  description      String?
  defaultTaxRateId String?   @map("default_tax_rate_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy        String?   @map("created_by") @db.Uuid
  updatedBy        String?   @map("updated_by") @db.Uuid

  organization   Organization    @relation(fields: [organizationId], references: [id])
  brand          Brand           @relation(fields: [brandId], references: [id])
  category       Category        @relation(fields: [categoryId], references: [id])
  defaultTaxRate TaxRate?        @relation(fields: [defaultTaxRateId], references: [id])
  variants       ArticleVariant[]

  @@index([organizationId])
  @@index([brandId])
  @@index([categoryId])
  @@map("articles")
}

model ArticleVariant {
  id                 String    @id @default(uuid()) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  articleId          String    @map("article_id") @db.Uuid
  size               String
  color              String
  sku                String
  barcode            String?
  mrp                Decimal   @db.Decimal(12, 2)
  sellingPrice       Decimal   @map("selling_price") @db.Decimal(12, 2)
  lowStockThreshold  Decimal   @default(0) @map("low_stock_threshold") @db.Decimal(12, 3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy          String?   @map("created_by") @db.Uuid
  updatedBy          String?   @map("updated_by") @db.Uuid

  organization      Organization       @relation(fields: [organizationId], references: [id])
  article           Article            @relation(fields: [articleId], references: [id])
  inventoryBalances InventoryBalance[]
  stockLedger       StockLedger[]
  purchaseLines     PurchaseLine[]
  saleLines         SaleLine[]
  exchangeLines     ExchangeLine[]

  @@index([organizationId])
  @@index([articleId])
  @@index([organizationId, sku])
  @@index([organizationId, barcode])
  @@map("article_variants")
}

// ─── Inventory ───────────────────────────────────────────────────────────────

model InventoryBalance {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  locationId     String    @map("location_id") @db.Uuid
  variantId      String    @map("variant_id") @db.Uuid
  quantity       Decimal   @default(0) @db.Decimal(12, 3)
  avgUnitCost    Decimal   @default(0) @map("avg_unit_cost") @db.Decimal(14, 4)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid

  organization Organization  @relation(fields: [organizationId], references: [id])
  location     Location      @relation(fields: [locationId], references: [id])
  variant      ArticleVariant @relation(fields: [variantId], references: [id])

  @@unique([locationId, variantId])
  @@index([organizationId, variantId])
  @@index([locationId])
  @@map("inventory_balances")
}

model StockLedger {
  id              String             @id @default(uuid()) @db.Uuid
  organizationId  String             @map("organization_id") @db.Uuid
  locationId      String             @map("location_id") @db.Uuid
  variantId       String             @map("variant_id") @db.Uuid
  movementType    StockMovementType  @map("movement_type")
  qtyChange       Decimal            @map("qty_change") @db.Decimal(12, 3)
  unitCost        Decimal            @map("unit_cost") @db.Decimal(14, 4)
  referenceType   ReferenceType      @map("reference_type")
  referenceId     String             @map("reference_id") @db.Uuid
  referenceLineId String?            @map("reference_line_id") @db.Uuid
  notes           String?
  occurredAt      DateTime           @map("occurred_at") @db.Timestamptz(6)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?          @map("deleted_at") @db.Timestamptz(6)
  createdBy       String?            @map("created_by") @db.Uuid
  updatedBy       String?            @map("updated_by") @db.Uuid

  organization Organization   @relation(fields: [organizationId], references: [id])
  location     Location       @relation(fields: [locationId], references: [id])
  variant      ArticleVariant @relation(fields: [variantId], references: [id])

  @@index([variantId, locationId, occurredAt])
  @@index([referenceType, referenceId])
  @@index([organizationId, occurredAt])
  @@map("stock_ledger")
}

// ─── Purchases ───────────────────────────────────────────────────────────────

model Purchase {
  id                String         @id @default(uuid()) @db.Uuid
  organizationId    String         @map("organization_id") @db.Uuid
  branchId          String         @map("branch_id") @db.Uuid
  locationId        String         @map("location_id") @db.Uuid
  vendorId          String         @map("vendor_id") @db.Uuid
  vendorInvoiceNo   String?        @map("vendor_invoice_no")
  vendorInvoiceDate DateTime?      @map("vendor_invoice_date") @db.Date
  status            DocumentStatus @default(DRAFT)
  subtotal          Decimal        @default(0) @db.Decimal(12, 2)
  discountAmount    Decimal        @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount         Decimal        @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount       Decimal        @default(0) @map("total_amount") @db.Decimal(12, 2)
  notes             String?
  postedAt          DateTime?      @map("posted_at") @db.Timestamptz(6)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?      @map("deleted_at") @db.Timestamptz(6)
  createdBy         String?        @map("created_by") @db.Uuid
  updatedBy         String?        @map("updated_by") @db.Uuid

  organization Organization   @relation(fields: [organizationId], references: [id])
  branch       Branch         @relation(fields: [branchId], references: [id])
  location     Location       @relation(fields: [locationId], references: [id])
  vendor       Vendor         @relation(fields: [vendorId], references: [id])
  lines        PurchaseLine[]

  @@index([organizationId])
  @@index([vendorId])
  @@index([postedAt])
  @@map("purchases")
}

model PurchaseLine {
  id             String    @id @default(uuid()) @db.Uuid
  purchaseId     String    @map("purchase_id") @db.Uuid
  variantId      String    @map("variant_id") @db.Uuid
  qty            Decimal   @db.Decimal(12, 3)
  unitRate       Decimal   @map("unit_rate") @db.Decimal(14, 4)
  discountAmount Decimal   @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxRateId      String?   @map("tax_rate_id") @db.Uuid
  taxableAmount  Decimal   @default(0) @map("taxable_amount") @db.Decimal(12, 2)
  cgstAmount     Decimal   @default(0) @map("cgst_amount") @db.Decimal(12, 2)
  sgstAmount     Decimal   @default(0) @map("sgst_amount") @db.Decimal(12, 2)
  igstAmount     Decimal   @default(0) @map("igst_amount") @db.Decimal(12, 2)
  lineTotal      Decimal   @default(0) @map("line_total") @db.Decimal(12, 2)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid

  purchase Purchase       @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  variant  ArticleVariant @relation(fields: [variantId], references: [id])
  taxRate  TaxRate?       @relation(fields: [taxRateId], references: [id])

  @@index([purchaseId])
  @@index([variantId])
  @@map("purchase_lines")
}

// ─── Sales ───────────────────────────────────────────────────────────────────

model Sale {
  id                  String         @id @default(uuid()) @db.Uuid
  organizationId      String         @map("organization_id") @db.Uuid
  branchId            String         @map("branch_id") @db.Uuid
  locationId          String         @map("location_id") @db.Uuid
  customerId          String         @map("customer_id") @db.Uuid
  invoiceNo           String         @map("invoice_no")
  invoiceDate         DateTime       @map("invoice_date") @db.Date
  status              DocumentStatus @default(DRAFT)
  placeOfSupplyState  String         @map("place_of_supply_state") @db.Char(2)
  isInterState        Boolean        @default(false) @map("is_inter_state")
  subtotal            Decimal        @default(0) @db.Decimal(12, 2)
  discountAmount      Decimal        @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount           Decimal        @default(0) @map("tax_amount") @db.Decimal(12, 2)
  roundOff            Decimal        @default(0) @map("round_off") @db.Decimal(12, 2)
  totalAmount         Decimal        @default(0) @map("total_amount") @db.Decimal(12, 2)
  paymentStatus       PaymentStatus  @default(UNPAID) @map("payment_status")
  notes               String?
  stockOverride       Boolean        @default(false) @map("stock_override")
  overrideReason      String?        @map("override_reason")
  postedAt            DateTime?      @map("posted_at") @db.Timestamptz(6)
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?      @map("deleted_at") @db.Timestamptz(6)
  createdBy           String?        @map("created_by") @db.Uuid
  updatedBy           String?        @map("updated_by") @db.Uuid

  organization Organization  @relation(fields: [organizationId], references: [id])
  branch       Branch        @relation(fields: [branchId], references: [id])
  location     Location      @relation(fields: [locationId], references: [id])
  customer     Customer      @relation(fields: [customerId], references: [id])
  lines        SaleLine[]
  payments     SalePayment[]
  exchanges    Exchange[]

  @@unique([organizationId, branchId, invoiceNo])
  @@index([organizationId, invoiceDate])
  @@index([customerId])
  @@map("sales")
}

model SaleLine {
  id             String    @id @default(uuid()) @db.Uuid
  saleId         String    @map("sale_id") @db.Uuid
  variantId      String    @map("variant_id") @db.Uuid
  qty            Decimal   @db.Decimal(12, 3)
  unitPrice      Decimal   @map("unit_price") @db.Decimal(12, 2)
  unitCost       Decimal   @default(0) @map("unit_cost") @db.Decimal(14, 4)
  discountAmount Decimal   @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxRateId      String?   @map("tax_rate_id") @db.Uuid
  hsnCode        String?   @map("hsn_code")
  taxableAmount  Decimal   @default(0) @map("taxable_amount") @db.Decimal(12, 2)
  cgstRate       Decimal   @default(0) @map("cgst_rate") @db.Decimal(5, 2)
  sgstRate       Decimal   @default(0) @map("sgst_rate") @db.Decimal(5, 2)
  igstRate       Decimal   @default(0) @map("igst_rate") @db.Decimal(5, 2)
  cgstAmount     Decimal   @default(0) @map("cgst_amount") @db.Decimal(12, 2)
  sgstAmount     Decimal   @default(0) @map("sgst_amount") @db.Decimal(12, 2)
  igstAmount     Decimal   @default(0) @map("igst_amount") @db.Decimal(12, 2)
  lineTotal      Decimal   @default(0) @map("line_total") @db.Decimal(12, 2)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid

  sale          Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variant       ArticleVariant @relation(fields: [variantId], references: [id])
  taxRate       TaxRate?       @relation(fields: [taxRateId], references: [id])
  exchangeLines ExchangeLine[]

  @@index([saleId])
  @@index([variantId])
  @@map("sale_lines")
}

model SalePayment {
  id        String        @id @default(uuid()) @db.Uuid
  saleId    String        @map("sale_id") @db.Uuid
  method    PaymentMethod
  amount    Decimal       @db.Decimal(12, 2)
  reference String?
  paidAt    DateTime      @default(now()) @map("paid_at") @db.Timestamptz(6)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime?     @map("deleted_at") @db.Timestamptz(6)
  createdBy String?       @map("created_by") @db.Uuid
  updatedBy String?       @map("updated_by") @db.Uuid

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@map("sale_payments")
}

// ─── Exchanges ───────────────────────────────────────────────────────────────

model Exchange {
  id              String         @id @default(uuid()) @db.Uuid
  organizationId  String         @map("organization_id") @db.Uuid
  branchId        String         @map("branch_id") @db.Uuid
  locationId      String         @map("location_id") @db.Uuid
  customerId      String         @map("customer_id") @db.Uuid
  originalSaleId  String?        @map("original_sale_id") @db.Uuid
  status          DocumentStatus @default(DRAFT)
  differenceAmount Decimal       @default(0) @map("difference_amount") @db.Decimal(12, 2)
  notes           String?
  postedAt        DateTime?      @map("posted_at") @db.Timestamptz(6)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?      @map("deleted_at") @db.Timestamptz(6)
  createdBy       String?        @map("created_by") @db.Uuid
  updatedBy       String?        @map("updated_by") @db.Uuid

  organization Organization   @relation(fields: [organizationId], references: [id])
  branch       Branch         @relation(fields: [branchId], references: [id])
  location     Location       @relation(fields: [locationId], references: [id])
  customer     Customer       @relation(fields: [customerId], references: [id])
  originalSale Sale?          @relation(fields: [originalSaleId], references: [id])
  lines        ExchangeLine[]

  @@index([organizationId])
  @@index([originalSaleId])
  @@map("exchanges")
}

model ExchangeLine {
  id                 String            @id @default(uuid()) @db.Uuid
  exchangeId         String            @map("exchange_id") @db.Uuid
  direction          ExchangeDirection
  variantId          String            @map("variant_id") @db.Uuid
  qty                Decimal           @db.Decimal(12, 3)
  unitPrice          Decimal           @map("unit_price") @db.Decimal(12, 2)
  unitCost           Decimal           @default(0) @map("unit_cost") @db.Decimal(14, 4)
  originalSaleLineId String?           @map("original_sale_line_id") @db.Uuid
  taxRateId          String?           @map("tax_rate_id") @db.Uuid
  hsnCode            String?           @map("hsn_code")
  taxableAmount      Decimal           @default(0) @map("taxable_amount") @db.Decimal(12, 2)
  cgstRate           Decimal           @default(0) @map("cgst_rate") @db.Decimal(5, 2)
  sgstRate           Decimal           @default(0) @map("sgst_rate") @db.Decimal(5, 2)
  igstRate           Decimal           @default(0) @map("igst_rate") @db.Decimal(5, 2)
  cgstAmount         Decimal           @default(0) @map("cgst_amount") @db.Decimal(12, 2)
  sgstAmount         Decimal           @default(0) @map("sgst_amount") @db.Decimal(12, 2)
  igstAmount         Decimal           @default(0) @map("igst_amount") @db.Decimal(12, 2)
  lineTotal          Decimal           @default(0) @map("line_total") @db.Decimal(12, 2)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?         @map("deleted_at") @db.Timestamptz(6)
  createdBy          String?           @map("created_by") @db.Uuid
  updatedBy          String?           @map("updated_by") @db.Uuid

  exchange         Exchange      @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  variant          ArticleVariant @relation(fields: [variantId], references: [id])
  originalSaleLine SaleLine?     @relation(fields: [originalSaleLineId], references: [id])
  taxRate          TaxRate?      @relation(fields: [taxRateId], references: [id])

  @@index([exchangeId])
  @@index([variantId])
  @@map("exchange_lines")
}

// ─── Expenses ────────────────────────────────────────────────────────────────

model ExpenseCategory {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id])
  expenses     Expense[]

  @@index([organizationId])
  @@map("expense_categories")
}

model Expense {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  branchId       String        @map("branch_id") @db.Uuid
  categoryId     String        @map("category_id") @db.Uuid
  amount         Decimal       @db.Decimal(12, 2)
  expenseDate    DateTime      @map("expense_date") @db.Date
  paymentMethod  PaymentMethod @map("payment_method")
  notes          String?
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamptz(6)
  createdBy      String?       @map("created_by") @db.Uuid
  updatedBy      String?       @map("updated_by") @db.Uuid

  organization Organization    @relation(fields: [organizationId], references: [id])
  branch       Branch          @relation(fields: [branchId], references: [id])
  category     ExpenseCategory @relation(fields: [categoryId], references: [id])

  @@index([organizationId, expenseDate])
  @@index([categoryId])
  @@map("expenses")
}

// ─── Sequences & audit ───────────────────────────────────────────────────────

model DocumentSequence {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  branchId       String       @map("branch_id") @db.Uuid
  docType        DocumentType @map("doc_type")
  prefix         String       @default("")
  fyLabel        String       @map("fy_label")
  nextNumber     Int          @default(1) @map("next_number")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy      String?      @map("created_by") @db.Uuid
  updatedBy      String?      @map("updated_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Branch       @relation(fields: [branchId], references: [id])

  @@unique([organizationId, branchId, docType, fyLabel])
  @@map("document_sequences")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id") @db.Uuid
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
