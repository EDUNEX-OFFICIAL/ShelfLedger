# ShelfLedger — copy to `/srv/ShelfLedger/.env` for local development

# Local Docker Postgres (see docker-compose.yml) — 127.0.0.1:5434
DATABASE_URL="postgresql://shelfledger:shelfledger@127.0.0.1:5434/shelfledger?schema=public"

# Next.js
NEXT_PUBLIC_APP_NAME="ShelfLedger"
APP_URL="http://127.0.0.1:3002"
WEB_PORT=3002

# Auth — required (min 32 chars). Local default is fine for Phase 2; rotate before production.
AUTH_SECRET="shelfledger-local-dev-secret-rotate-before-prod-32"

# Seed owner (db:seed)
SEED_OWNER_EMAIL="owner@shelfledger.local"
SEED_OWNER_PASSWORD="ChangeMe!Owner1"
SEED_OWNER_NAME="Shop Owner"
SEED_ORG_NAME="Demo Retail Store"
SEED_ORG_STATE_CODE="27"
AUTH_URL="http://127.0.0.1:3002"
