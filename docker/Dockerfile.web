# syntax=docker/dockerfile:1
# Multi-stage Next.js (standalone) for ShelfLedger web.
FROM node:20-bookworm-slim AS base
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@8.15.0 --activate
WORKDIR /repo

FROM base AS deps
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/web/package.json ./apps/web/
COPY packages/db/package.json ./packages/db/
COPY packages/domain/package.json ./packages/domain/
COPY packages/errors/package.json ./packages/errors/
COPY packages/validators/package.json ./packages/validators/
COPY packages/tsconfig/package.json ./packages/tsconfig/
COPY packages/tsconfig/*.json ./packages/tsconfig/
RUN --mount=type=cache,id=shelfledger-pnpm-store,target=/root/.local/share/pnpm/store \
  pnpm install --frozen-lockfile

FROM deps AS build
COPY apps/web ./apps/web
COPY packages ./packages
# Prisma generate needs a URL shape only (no live DB).
ENV DATABASE_URL="postgresql://ci:ci@127.0.0.1:5432/ci?schema=public"
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production
RUN pnpm db:generate
RUN pnpm --filter @shelfledger/web build

FROM base AS runner
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
RUN groupadd --system shelfledger \
  && useradd --system --gid shelfledger --create-home shelfledger
WORKDIR /repo

COPY --from=build --chown=shelfledger:shelfledger /repo/apps/web/.next/standalone ./
COPY --from=build --chown=shelfledger:shelfledger /repo/apps/web/.next/static ./apps/web/.next/static
RUN mkdir -p ./apps/web/public
# Prisma schema + client engines for migrate / runtime
COPY --from=build --chown=shelfledger:shelfledger /repo/packages/db/prisma ./packages/db/prisma
COPY --from=build --chown=shelfledger:shelfledger /repo/node_modules/.pnpm ./node_modules/.pnpm
COPY --from=build --chown=shelfledger:shelfledger /repo/node_modules/@prisma ./node_modules/@prisma
COPY --from=build --chown=shelfledger:shelfledger /repo/node_modules/prisma ./node_modules/prisma
COPY --from=build --chown=shelfledger:shelfledger /repo/node_modules/.prisma ./node_modules/.prisma
COPY --from=build --chown=shelfledger:shelfledger /repo/packages/db/node_modules ./packages/db/node_modules
COPY --from=build --chown=shelfledger:shelfledger /repo/package.json /repo/pnpm-workspace.yaml ./
COPY --from=build --chown=shelfledger:shelfledger /repo/packages/db/package.json ./packages/db/

USER shelfledger
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --retries=5 --start-period=40s \
  CMD node -e "fetch('http://127.0.0.1:3000/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "apps/web/server.js"]
